Content-Type: application/json

{
    "name" : "Boss2",
    "email" : "boss2@ggg.com",
    "password" : "123456"
}

### login
POST {{BASE_URL}}/auth/login
Content-Type: application/json

{
    "email" : "boss2@ggg.com",
    "password" : "123456"
}

